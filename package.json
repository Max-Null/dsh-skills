{
  "name": "@max-null/dsh-skills",
  "version": "0.1.2",
  "description": "思灵的技能库：DSH 官方 .agents/skills 的工程判据适配版 + 思灵自创的工作流技能，每份 skill 附 SOURCE.md 标记来源与迭代方式",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepack": "node scripts/clean-pycache.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max-Null/dsh-skills.git"
  },
  "homepage": "https://github.com/Max-Null/dsh-skills#readme",
  "bugs": {
    "url": "https://github.com/Max-Null/dsh-skills/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ssid",
    "skill",
    "skills"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
